{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "st-tour-inquiries",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"st-tour-inquiries","database_id":"REPLACE_WITH_D1_ID","migrations_dir":"migrations"}],
  "triggers":{"crons":["*/5 * * * *"]},
  "vars": {
    "ALLOWED_ORIGINS":"https://www.stgolftours.com,https://stgolftours.com",
    "TURNSTILE_HOSTNAMES":"www.stgolftours.com,stgolftours.com",
    "ACCESS_ISSUER":"",
    "ACCESS_AUDIENCE":"",
    "ADMIN_EMAILS":"goltimjang@gmail.com",
    "ADMIN_ORIGIN":"",
    "MAIL_FROM":"",
    "MAIL_TO":"goltimjang@gmail.com"
  },
  "observability":{"enabled":false}
}
